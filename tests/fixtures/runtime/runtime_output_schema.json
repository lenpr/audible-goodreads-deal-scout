{
  "additionalProperties": false,
  "properties": {
    "fit": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "sentence": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "written"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "sentence": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "sentence"
            ]
          }
        }
      ],
      "properties": {
        "sentence": {
          "description": "When status is written, a 45-90 word Fit paragraph.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "written",
            "not_applicable",
            "unavailable"
          ]
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "goodreads": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "author": {
                "type": "null"
              },
              "averageRating": {
                "type": "null"
              },
              "ratingsCount": {
                "type": "null"
              },
              "title": {
                "type": "null"
              },
              "url": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "resolved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "author": {
                "type": "string"
              },
              "averageRating": {
                "type": "number"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "url",
              "title",
              "author",
              "averageRating"
            ]
          }
        }
      ],
      "properties": {
        "author": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "averageRating": {
          "maximum": 5,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "ratingsCount": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "enum": [
            "resolved",
            "no_match",
            "lookup_failed"
          ]
        },
        "title": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "pattern": "^https://(?:www\\.)?goodreads\\.com/book/show/",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": 1
    }
  },
  "required": [
    "schemaVersion",
    "goodreads",
    "fit"
  ],
  "schemaVersion": 1,
  "type": "object"
}
